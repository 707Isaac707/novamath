# Nova Math - Render environment template
# Copy to .env locally OR paste into Render -> Environment -> Add from .env.
# NEVER commit a real .env containing secrets.

# Accounts / sessions
MEDIAHUB_AUTH_SECRET=PASTE_EXISTING_VALUE
MEDIAHUB_ADMIN_USERNAME=PASTE_NOVA_ADMIN_USERNAME

# Upstash Redis
UPSTASH_REDIS_REST_URL=PASTE_EXISTING_VALUE
UPSTASH_REDIS_REST_TOKEN=PASTE_EXISTING_VALUE

# Nova AI / UnoRouter
UNOROUTER_API_KEY=PASTE_EXISTING_VALUE
UNOROUTER_MODEL=PASTE_EXISTING_VALUE
UNOROUTER_FALLBACK_MODELS=

# Media / game art
YOUTUBE_API_KEY=PASTE_EXISTING_VALUE
STEAMGRIDDB_API_KEY=PASTE_EXISTING_VALUE

# Discord notifications
FOOD_REQUEST_DISCORD_WEBHOOK=PASTE_EXISTING_VALUE
NOVA_REPORTS_WEBHOOK=PASTE_EXISTING_VALUE
NOVA_ADMIN_ALERTS_WEBHOOK=PASTE_EXISTING_VALUE

# GitHub sports scraper -> Nova ingest
# Must exactly match the GitHub Actions secret BOTASAURUS_INGEST_SECRET.
BOTASAURUS_INGEST_SECRET=PASTE_EXISTING_VALUE
